# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgresql://user:password@host:5432/engineerd
SIMPLIFYJOBS_API_KEY=

# Owner-only manual refresh. Leave unset to disable it (recommended in production).
ADMIN_TOKEN=

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Scheduled ingestion (optional; defaults shown)
# INGEST_SCHEDULE_ENABLED=1
# INGEST_HOURS=0,6,12,18
# INGEST_MARKETS=canada
# INGEST_TIMEZONE=America/Toronto
